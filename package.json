{
  "name": "vite-pwa-nuxt-monorepo",
  "type": "module",
  "version": "1.1.1",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "description": "Nuxt PWA Ecosystem",
  "author": "antfu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/vite-pwa/nuxt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-pwa/nuxt.git"
  },
  "bugs": "https://github.com/vite-pwa/nuxt/issues",
  "scripts": {
    "build": "pnpm -r --filter=\"./packages/**/\" run build",
    "pack:all": "pnpm -r --filter=\"./packages/**/\" pack",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:typecheck": "pnpm -r --filter=\"./packages/**/\" run test:typecheck",
    "dev": "pnpm -C examples/playground-v4 run dev",
    "dev:build": "pnpm -C examples/playground-v3 run build",
    "dev:generate": "pnpm -C examples/playground-v3 run generate",
    "test:build:serve": "PORT=4173 node examples/playground-v3/.output/server/index.mjs",
    "test:generate:serve": "serve -l 4173 examples/playground-v3/.output/public",
    "test:build": "pnpm run dev:build && TEST_BUILD=true vitest run && TEST_BUILD=true playwright test",
    "test:generate": "pnpm run dev:generate && vitest run && playwright test",
    "test:consumer": "node scripts/test-consumer.mjs",
    "test:consumer:v3": "NUXT_VERSION=^3.21.0 node scripts/test-consumer.mjs",
    "test:consumer:v4": "NUXT_VERSION=^4.0.0 node scripts/test-consumer.mjs",
    "test:consumer:v3:keep": "KEEP_FIXTURE=true NUXT_VERSION=^3.21.0 node scripts/test-consumer.mjs",
    "test": "pnpm run test:build && pnpm run test:generate"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:eslint",
    "@arethetypeswrong/core": "catalog:utils",
    "@nuxt/module-builder": "catalog:build",
    "@playwright/test": "catalog:utils",
    "@types/node": "catalog:types",
    "eslint": "catalog:eslint",
    "publint": "catalog:utils",
    "serve": "catalog:utils",
    "taze": "catalog:utils",
    "tsdown": "catalog:build",
    "typescript": "catalog:typescript",
    "vitest": "catalog:utils",
    "vue-tsc": "catalog:utils"
  }
}
