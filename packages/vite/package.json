{
  "name": "@vite-pwa/nuxt-vite",
  "type": "module",
  "version": "1.1.1",
  "description": "Zero-config PWA for Nuxt with Vite Builder",
  "author": "antfu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/vite-pwa/nuxt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-pwa/nuxt.git",
    "directory": "packages/vite"
  },
  "bugs": "https://github.com/vite-pwa/nuxt/issues",
  "keywords": [
    "nuxt",
    "pwa",
    "workbox",
    "unplugin-pwa",
    "vite",
    "vite builder"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm run build",
    "test:typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@vite-pwa/assets-generator": "^1.0.0 || ^2.0.0",
    "magicast": "^0.5.0",
    "rolldown": "^1.0.0-0"
  },
  "peerDependenciesMeta": {
    "@vite-pwa/assets-generator": {
      "optional": true
    },
    "magicast": {
      "optional": true
    },
    "rolldown": {
      "optional": true
    }
  },
  "dependencies": {
    "@nuxt/kit": "catalog:utils",
    "@rolldown/pluginutils": "catalog:utils",
    "@unplugin-pwa/core": "catalog:pwa",
    "@unplugin-pwa/vite": "catalog:pwa",
    "@vite-pwa/nuxt-core": "workspace:*",
    "@vite-pwa/workbox-build": "catalog:pwa",
    "verkit": "catalog:utils"
  },
  "devDependencies": {
    "@nuxt/schema": "catalog:utils"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
