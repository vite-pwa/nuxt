{
  "name": "@vite-pwa/nuxt-core",
  "type": "module",
  "version": "2.0.1",
  "description": "Nuxt PWA types and external configuration",
  "author": "antfu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/vite-pwa/nuxt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-pwa/nuxt.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/vite-pwa/nuxt/issues",
  "keywords": [
    "nuxt",
    "pwa",
    "workbox",
    "unplugin-pwa",
    "configuration"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./config": "./dist/config.mjs",
    "./context-types": {
      "types": "./dist/context-types.d.mts"
    },
    "./shared-types": {
      "types": "./dist/shared-types.d.mts"
    },
    "./types": {
      "types": "./dist/types.d.mts"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm run build",
    "test:typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@unplugin-pwa/core": "catalog:pwa",
    "@vite-pwa/workbox-build": "catalog:pwa"
  },
  "devDependencies": {
    "@nuxt/schema": "catalog:utils",
    "rolldown": "catalog:utils"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
