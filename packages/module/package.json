{
  "name": "@vite-pwa/nuxt",
  "type": "module",
  "version": "2.0.3",
  "description": "Zero-config PWA for Nuxt",
  "author": "antfu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/vite-pwa/nuxt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-pwa/nuxt.git",
    "directory": "packages/module"
  },
  "bugs": "https://github.com/vite-pwa/nuxt/issues",
  "keywords": [
    "nuxt",
    "pwa",
    "workbox",
    "unplugin-pwa",
    "nuxt-module"
  ],
  "exports": {
    ".": {
      "types": "./.nuxt/module-builder/types.d.mts",
      "default": "./src/module.ts"
    },
    "./config": "./config/index.mjs",
    "./configuration": {
      "types": "./configuration.d.ts"
    }
  },
  "main": "./src/module.ts",
  "files": [
    "*.d.ts",
    "config",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare:module": "nuxt module-build prepare",
    "prepack": "pnpm run build",
    "test:typecheck": "vue-tsc -b --noEmit"
  },
  "peerDependencies": {
    "@vite-pwa/assets-generator": "^1.0.0 || ^2.0.0",
    "magicast": "^0.5.0",
    "rolldown": "^1.0.0-0"
  },
  "peerDependenciesMeta": {
    "@vite-pwa/assets-generator": {
      "optional": true
    },
    "magicast": {
      "optional": true
    },
    "rolldown": {
      "optional": true
    }
  },
  "dependencies": {
    "@nuxt/kit": "catalog:utils",
    "@unplugin-pwa/core": "catalog:pwa",
    "@vite-pwa/nuxt-core": "workspace:*",
    "@vite-pwa/nuxt-vite": "workspace:*",
    "@vite-pwa/workbox-build": "catalog:pwa",
    "defu": "catalog:utils",
    "verkit": "catalog:utils"
  },
  "devDependencies": {
    "@nuxt/devtools-kit": "catalog:utils",
    "@nuxt/schema": "catalog:utils",
    "@vite-pwa/assets-generator": "catalog:pwa",
    "nuxt": "catalog:utils"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/types.d.mts",
        "default": "./dist/module.mjs"
      },
      "./config": "./config/index.mjs",
      "./configuration": {
        "types": "./configuration.d.ts"
      },
      "./package.json": "./package.json"
    },
    "main": "./dist/module.mjs"
  }
}
